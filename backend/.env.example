PORT=5000

# Use DATABASE_URL in cloud deployments. For local PostgreSQL, configure DB_* instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_USER=postgres
DB_HOST=localhost
DB_NAME=nivestha_db
DB_PASSWORD=
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated frontend origins (no trailing slash).
CLIENT_URLS=http://localhost:5173,http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BASE_URL=http://localhost:5000
TRUST_PROXY=false
